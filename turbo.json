{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "packages/tsconfig/*.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_API_URL", "API_PROXY_TARGET", "DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "NEXT_PUBLIC_API_URL",
        "LOG_LEVEL",
        "SMTP_URL",
        "APP_URL",
        "API_URL",
        "CORS_ORIGINS",
        "PORT",
        "ENCRYPTION_KEY",
        "ENABLE_DEMO_ACCOUNT"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET"]
    },
    "db:generate": {
      "cache": false
    },
    "@nosion/worker#test:int": {
      "cache": false,
      "dependsOn": ["^build", "@nosion/api#test:int"],
      "env": ["DATABASE_URL", "REDIS_URL"]
    }
  }
}
