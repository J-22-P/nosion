{
  "name": "@nosion/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run && node scripts/check-messages.mjs",
    "test:e2e": "playwright test --project=smoke",
    "icons": "node scripts/generate-icons.mjs",
    "test:ui": "playwright test --project=ui",
    "test:ui:update": "playwright test --project=ui --update-snapshots=all",
    "test:ui:docker": "bash scripts/playwright-docker.sh",
    "test:i18n": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@nosion/contracts": "workspace:*",
    "@nosion/core": "workspace:*",
    "@nosion/ui": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "15.5.25",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nosion/eslint-config": "workspace:*",
    "@nosion/tsconfig": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "intl-messageformat": "11.2.15",
    "lighthouse": "13.5.0",
    "puppeteer-core": "25.13.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
