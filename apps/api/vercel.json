{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm db:generate && pnpm turbo run build --filter=@nosion/api && mkdir -p apps/api/public && echo ok > apps/api/public/health.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": "{dist/**,node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/recurrence",
      "schedule": "0 3 * * *"
    }
  ]
}
