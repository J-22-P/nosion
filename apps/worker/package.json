{
  "name": "@nosion/worker",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@nosion/contracts": "workspace:*",
    "@nosion/core": "workspace:*",
    "@nosion/emails": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "zod": "3.25.76",
    "@nosion/notifications": "workspace:*"
  },
  "devDependencies": {
    "@nosion/eslint-config": "workspace:*",
    "@nosion/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
