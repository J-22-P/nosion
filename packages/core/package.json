{
  "name": "@nosion/core",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./recurrence": {
      "types": "./dist/recurrence.d.ts",
      "default": "./dist/recurrence.js"
    },
    "./nl": {
      "types": "./dist/nl.d.ts",
      "default": "./dist/nl.js"
    },
    "./intl": {
      "types": "./dist/intl.d.ts",
      "default": "./dist/intl.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nosion/contracts": "workspace:*",
    "rrule": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nosion/eslint-config": "workspace:*",
    "@nosion/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
