{
  "extends": "@nosion/tsconfig/library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // buildinfo อยู่ใน dist: ลบ dist เมื่อไร buildinfo หายตาม → tsc ไม่เข้าใจผิดว่าไฟล์ที่ไม่เปลี่ยน emit ไว้แล้ว
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
