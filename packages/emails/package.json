{
  "name": "@nosion/emails",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "nodemailer": "10.1.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@nosion/eslint-config": "workspace:*",
    "@nosion/tsconfig": "workspace:*",
    "@types/node": "22.20.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
