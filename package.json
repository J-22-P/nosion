{
  "name": "nosion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:int:local": "node scripts/test-int-local.mjs",
    "test:e2e": "pnpm --filter @nosion/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "setup:dev": "node scripts/setup-dev.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm build",
    "db:migrate:indexes": "node scripts/create-index-migration.mjs"
  },
  "devDependencies": {
    "@nosion/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "handlebars": ">=4.7.9",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18",
      "multer": ">=2.3.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  },
  "prisma": {
    "seed": "tsx apps/api/prisma/seed.ts"
  }
}
