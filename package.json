{
  "name": "nosion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:e2e": "pnpm --filter @nosion/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "db:generate": "pnpm --filter @nosion/api db:generate",
    "db:migrate": "pnpm --filter @nosion/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @nosion/api db:migrate:deploy",
    "db:seed": "pnpm --filter @nosion/api db:seed",
    "db:reset": "pnpm --filter @nosion/api db:reset",
    "db:studio": "pnpm --filter @nosion/api db:studio",
    "setup:dev": "node scripts/setup-dev.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm build",
    "db:migrate:indexes": "node scripts/create-index-migration.mjs"
  },
  "devDependencies": {
    "@nosion/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
