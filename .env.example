# ── Core ─────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────
DATABASE_URL=postgresql://nosion:nosion@localhost:5432/nosion_dev
DATABASE_POOL_SIZE=10

# ── Redis ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────
# ว่างไว้ — `pnpm setup:dev` สุ่มค่าใหม่ให้ตอนสร้าง .env (คนละค่าทุกเครื่อง)
# สร้างเองได้ด้วย: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# AES-256 สำหรับ TOTP secret — hex 64 ตัว · setup:dev สุ่มให้เช่นกัน (openssl rand -hex 32)
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Notification ─────────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=NOSION <noreply@nosion.dev>

# ── Storage ──────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nosion-uploads

# ── Observability ────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ── Feature toggles ──────────────────
ENABLE_DEMO_ACCOUNT=true
ENABLE_OCR=false

# ── Web (Next.js) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
